#!/bin/bash
set -e

case "$1" in
    configure)
        # Create group randbotd if it doesn't exist
        if ! getent group randbotd >/dev/null 2>&1; then
            groupadd -r randbotd
        fi

        # Create user randbotd if it doesn't exist
        if ! getent passwd randbotd >/dev/null 2>&1; then
            useradd -r -g randbotd -d /var/lib/randbotd -s /bin/false -c "randbotd daemon user" randbotd
        fi

        # Create directories and assign ownership
        mkdir -p /var/lib/randbotd /etc/randbotd
        chown -R randbotd:randbotd /var/lib/randbotd /etc/randbotd
        chmod 750 /var/lib/randbotd /etc/randbotd

        # Reload systemd configuration
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi

        echo "================================================================================"
        echo " 🛡️ randbotd systemd service configured."
        echo " Note: In headless daemon mode, randbotd requires a master passphrase."
        echo " Option A (Linux Kernel Keyring):"
        echo "   keyctl add user randbotd:masterpass \"your_secret_passphrase\" @s"
        echo " Option B (Encrypted systemd Credential):"
        echo "   echo -n \"your_secret_passphrase\" | sudo systemd-creds encrypt --name=masterpass - /etc/randbotd/masterpass.cred"
        echo " Option C (Insecure /etc/machine-id fallback):"
        echo "   ExecStart=/usr/bin/randbotd --mode=headless --allow-insecure-machine-id-fallback"
        echo "================================================================================"
    ;;
esac

exit 0
